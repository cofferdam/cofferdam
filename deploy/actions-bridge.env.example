# Example environment file for the Cofferdam Actions bridge (M2I.5 Gate A).
#
#   cp deploy/actions-bridge.env.example ~/cofferdam/actions-bridge.env
#   chmod 600 ~/cofferdam/actions-bridge.env
#   # then replace every CHANGE_ME below
#
# NEITHER CREDENTIAL BELONGS IN THIS FILE, and neither has an environment
# variable that would accept it. The bridge reads both from 0600 files:
#
#   $COFFERDAM_HOME/secrets/actions-bridge-key             the EXTERNAL Actions
#                                                          key, held by the
#                                                          Custom GPT
#   $COFFERDAM_HOME/secrets/actions-bridge-internal-token  the INTERNAL token,
#                                                          generated by the
#                                                          daemon
#
# That is deliberate rather than incidental: an environment variable is visible
# in /proc for anything that can read the process, and is inherited by every
# child. A 0600 file is read once, at startup, into a closure.

# Where state, secrets and the bridge's idempotency table live. The unit already
# sets this; it is repeated here so the file is usable on its own when running
# the bridge by hand.
COFFERDAM_HOME=/home/CHANGE_ME/cofferdam

# --- the local listener -----------------------------------------------------
#
# Loopback, always. Cloudflare reaches this port through an OUTBOUND tunnel
# connection, so the listener never needs to be on an interface. Binding it
# anywhere else additionally requires --allow-public-bind on the command line,
# which this deployment never passes.
COFFERDAM_BRIDGE_BIND_HOST=127.0.0.1
COFFERDAM_BRIDGE_BIND_PORT=7210

# --- the daemon this bridge talks to ----------------------------------------
#
# An origin, and nothing but an origin: a path, query, fragment or embedded
# credential here is a startup failure, because a base URL carrying a path would
# re-point every fixed suffix the internal client appends.
#
# The code default is http://127.0.0.1:7101. Set this only when the workstation
# daemon does NOT listen on loopback — which is the case on a host that binds
# its private tailnet address, as docs/host-setup.md instructs. Use the value
# from `tailscale ip -4`; it is a private address on a private network and never
# leaves this file.
COFFERDAM_BRIDGE_INTERNAL_BASE_URL=http://100.x.y.z:7101
