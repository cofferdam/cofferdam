# Example environment file for the Cofferdam workstation service.
# Copy to ~/cofferdam/workstation.env and edit. NEVER commit a real token.
#
#   cp deploy/workstation.env.example ~/cofferdam/workstation.env
#   chmod 600 ~/cofferdam/workstation.env

# Where state, secrets, screenshots and logs live.
COFFERDAM_HOME=/home/CHANGE_ME/cofferdam

# Bind address. Default is 127.0.0.1 (loopback only).
# For phone access set this to the host's Tailscale address — never 0.0.0.0 on
# a public interface. Find it with: tailscale ip -4
COFFERDAM_BIND_HOST=100.x.y.z
COFFERDAM_BIND_PORT=7101

# Host adapter: auto | linux-x11 | windows | stub
# Leave as auto. Setting stub disables all real host control.
COFFERDAM_ADAPTER=auto

# The device token is read from $COFFERDAM_HOME/secrets/token (generated on
# first start, mode 0600). Only set COFFERDAM_TOKEN here if you deliberately
# want to manage it yourself, and keep this file 0600 if you do.
# COFFERDAM_TOKEN=
